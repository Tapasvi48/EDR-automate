# --- CrowdStrike Falcon API (Hosts: READ scope required) ---
# Optional: credentials are normally entered in the app under Sync & settings.
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
# us-1 | us-2 | eu-1 | us-gov-1  (or full URL, e.g. https://api.us-2.crowdstrike.com)
FALCON_BASE_URL=us-1
# Optional: for MSSP / Flight Control child CID
FALCON_MEMBER_CID=

# --- App ---
DB_PATH=data/edr_assets.db
HOST=127.0.0.1
PORT=8765
# Optional HTTP basic auth for the dashboard (leave empty to disable)
APP_USERNAME=
APP_PASSWORD=
